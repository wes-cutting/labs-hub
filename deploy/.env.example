# deploy/.env.example — copy to deploy/.env (gitignored) on the Pi and adjust.
# The hub reads these at `docker compose up`. No secrets belong here yet;
# if a service later needs one, add it and keep the real .env out of git.

# The hostname (or IP) you reach the hub at on your LAN — the ONE place to change it.
# It flows into Homepage's allowed-hosts AND every service tile link (via Compose ${...}),
# so cloning this project = set this one value. Default is the Pi's mDNS name, which follows
# the Pi across networks and DHCP IP changes; use your own hostname or a static IP if you
# prefer. For multiple access names, Homepage allows a comma-separated host list.
LABS_HUB_HOST=raspberrypi.local

# Persistent data-root for service state (ADR-0002). One subtree per service.
# Point this at an external SSD once SPIKE-02 validates the medium.
LABS_HUB_DATA_ROOT=/srv/labs-hub

# Media library root for Jellyfin (LH-S2), mounted read-only. Point at your media
# location (or an external drive). Defaults under the data-root.
LABS_HUB_MEDIA_ROOT=/srv/labs-hub/media

# --- Budgeteer demo instance (LH-S3-demo) ---
# The FIRST secrets this file has needed. Generate them once, per host, and keep the real
# deploy/.env out of git (it is gitignored). The stack has NO fallback for either and fails
# loudly by name without them:
#   BUDGETEER_DEMO_POSTGRES_PASSWORD=$(openssl rand -hex 16)
#   BUDGETEER_DEMO_SESSION_SECRET=$(openssl rand -base64 48)
# Do not regenerate them casually: the database password must keep matching the data-root
# directory it initialized, and a new session secret signs out whoever is mid-demo.
BUDGETEER_DEMO_POSTGRES_PASSWORD=
BUDGETEER_DEMO_SESSION_SECRET=

# Host port for the demo app, and the LOOPBACK-ONLY port used to seed it (see deploy/README.md).
BUDGETEER_DEMO_PORT=3010
BUDGETEER_DEMO_DB_PORT=5434

# Session cookie posture. Must stay false while the hub serves plain http:// — a browser
# discards a Secure cookie sent over HTTP, so sign-in would silently bounce. Set true once
# the hub terminates TLS (budgeteer DEPLOY_CONTRACT §5).
BUDGETEER_DEMO_COOKIE_SECURE=false

# The image to run. Defaults to the digest-pinned release in compose.budgeteer-demo.yml;
# override to try another build.
# BUDGETEER_IMAGE=ghcr.io/wes-cutting/budgeteer:v0.2.0
