# deploy/.env.example — copy to deploy/.env (gitignored) on the Pi and adjust.
# The hub reads these at `docker compose up`. No secrets belong here yet;
# if a service later needs one, add it and keep the real .env out of git.

# Host(s) Homepage will be served on (it rejects other Host headers). Match how
# you reach it on the LAN. If you DHCP-reserve or hostname the Pi, update this.
HOMEPAGE_ALLOWED_HOSTS=192.168.1.185:3000

# Persistent data-root for service state (ADR-0002). One subtree per service.
# Point this at an external SSD once SPIKE-02 validates the medium.
LABS_HUB_DATA_ROOT=/srv/labs-hub

# Media library root for Jellyfin (LH-S2), mounted read-only. Point at your media
# location (or an external drive). Defaults under the data-root.
LABS_HUB_MEDIA_ROOT=/srv/labs-hub/media
